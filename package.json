{
  "name": "hffmnnj.goals",
  "version": "1.0.1",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hffmnnj/opencode-goals.git"
  },
  "exports": {
    ".": "./dist/index.js",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "index.ts",
    "dist/index.js",
    "src/**/*.ts",
    "assets/banner.png",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "packageManager": "bun@1.4.2",
  "dependencies": {
    "@opencode/ai": "2.0.32",
    "@opencode/plugin": "2.0.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@opencode/client": "2.0.32",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --external '@opencode/*' --external zod",
    "check": "bun run typecheck && bun test && bun run build",
    "prepack": "bun run build"
  }
}
